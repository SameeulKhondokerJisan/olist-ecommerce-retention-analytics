table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		summarizeBy: sum
		sourceColumn: year

	column month
		dataType: int64
		summarizeBy: sum
		sourceColumn: month

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column quarter
		dataType: int64
		summarizeBy: sum
		sourceColumn: quarter

	column day_of_week
		dataType: int64
		summarizeBy: sum
		sourceColumn: day_of_week

	column day_name
		dataType: string
		summarizeBy: none
		sourceColumn: day_name

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"date", type datetime}, {"year", Int64.Type}, {"month", Int64.Type}, {"year_month", type text}, {"quarter", Int64.Type}, {"day_of_week", Int64.Type}, {"day_name", type text}}, "en-US")
				in
				    Typed

